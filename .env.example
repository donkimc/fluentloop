# Copy to .env for local development. Never commit real values.
# Production values live only in Render environment variables.

NODE_ENV=development

# LLM (Phase 1)
ANTHROPIC_API_KEY=

# Database (Phase 1) — Neon connection string
DATABASE_URL=

# Cloudflare R2 (Phase 1)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Error monitoring (optional)
SENTRY_DSN=
