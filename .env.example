# Copy to .env for local development. Never commit real values.
# Production values live only in Railway environment variables.

NODE_ENV=development

# LLM (Phase 1)
ANTHROPIC_API_KEY=

# Database (Phase 1) — Postgres connection string (Railway sets it in production)
DATABASE_URL=

# Railway Bucket, S3-compatible (Phase 1). Values come from the bucket's Credentials tab.
BUCKET=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
REGION=
ENDPOINT=

# Error monitoring (optional)
SENTRY_DSN=
